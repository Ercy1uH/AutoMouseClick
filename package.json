{
  "name": "mouseclik",
  "version": "1.5.0",
  "description": "点序 Windows 多点连点器",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "prepare:github": "node scripts/prepare-github.cjs",
    "test": "npm run test:unit && npm run test:worker && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/worker-settings.test.ps1",
    "test:ui": "node tests/run-suites.cjs ui",
    "test:e2e": "node tests/run-suites.cjs e2e",
    "test:desktop": "node tests/run-suites.cjs desktop",
    "start": "electron .",
    "dist": "node scripts/clean-dist.cjs && electron-builder --win portable && node scripts/verify-dist.cjs"
  },
  "build": {
    "appId": "local.mouseclik.app",
    "productName": "MouseClik",
    "asar": false,
    "files": [
      "src/renderer/index.html",
      "src/renderer/floating.html",
      "src/renderer/floating.css",
      "src/renderer/floating.js",
      "src/renderer/style.css",
      "src/renderer/app.js",
      "src/main/server.js",
      "src/core/debug-log.js",
      "src/core/run-history.js",
      "src/core/profile-store.js",
      "src/renderer/point-settings.js",
      "src/worker/native-click-worker.ps1",
      "src/main/main.js",
      "src/main/preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "MouseClik-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.63.0"
  }
}
